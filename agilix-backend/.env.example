PORT=3000
MONGODB_URI=mongodb://localhost:27017/agilix

OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,poolside/laguna-s-2.1:free

AI_TIMEOUT_MS=30000

AI_APP_URL=http://localhost:3000

ANTHROPIC_API_KEY=
# Login tokens. Generate a secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=PASTE_A_GENERATED_SECRET_HERE
JWT_EXPIRES_IN=1d

# Access codes for signing up as manager or admin on the sign-up page.
# Leave empty to disable that role on sign-up (admins can still create accounts).
# use this command to generate a random code: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SIGNUP_CODE=
MANAGER_SIGNUP_CODE=
BURNOUT_LIMIT_HOURS=0.5

# MCP server: the AgiliX account the MCP tools act as (same permissions as in the web app).
# Use a manager account to get the team reports. Leave empty to allow only agilix_server_info.
MCP_USER_EMAIL=

# GitHub MCP (AgiliX reads each project's linked repo through GitHub's MCP server).
# A fine-grained personal access token with read-only access to the repos: Contents,
# Pull requests and Metadata (github.com → Settings → Developer settings → Tokens).
GITHUB_MCP_TOKEN=
# Optional. Default: https://api.githubcopilot.com/mcp/
GITHUB_MCP_URL=
# Time zone for "late-night" and "weekend" commits (IANA name).
TEAM_TIMEZONE=Asia/Kolkata

# Google Calendar (each person connects their own calendar from the profile menu).
# Google Cloud Console → APIs & Services: enable "Google Calendar API", set up the OAuth
# consent screen (add each tester's Google account under "Test users"), then create an
# OAuth client ID of type "Web application" with this redirect URI:
#   http://localhost:3000/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Default: http://localhost:<PORT>/integrations/google-calendar/callback
GOOGLE_REDIRECT_URI=
# Where the browser returns after Google (the web app). Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Optional. Key that encrypts the saved Google tokens (at least 32 characters). Default: JWT_SECRET.
# If you set it later, people have to connect their calendar again.
CALENDAR_TOKEN_KEY=
